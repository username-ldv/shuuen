APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=9999
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_BODY_LIMIT_BYTES=67108864
CORS_ALLOWED_ORIGINS=*
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1m
ADMIN_RATE_LIMIT_MAX=3
ADMIN_RATE_LIMIT_WINDOW=1m

# sqlite is useful for local development. Use postgres in production.
DATABASE_DRIVER=sqlite
DATABASE_DSN=data/shuuen.db
AUTO_MIGRATE=true
DATABASE_MAX_OPEN_CONNS=4
DATABASE_MAX_IDLE_CONNS=4
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m

# Change this before deploying. Production startup fails if this value is empty
# or left as the development default.
JWT_SECRET=dev-secret-change-me
JWT_ISSUER=shuuen-backend
ACCESS_TOKEN_TTL=24h
REGISTRATION_ENABLED=true
# Set both values for the first startup, then remove them after the admin exists.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

DATA_ROOT=data
FOLDER_METADATA_FILE=.shuuen.json
MELODY_METADATA_SUFFIX=.shuuen.json
MAX_UPLOAD_SIZE=52428800
CATALOG_SCAN_ON_STARTUP=true
