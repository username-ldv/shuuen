# Production settings for the Docker stack. On the server, copy this file to
# `.env` next to compose.yaml and fill in every value. `.env` is git-ignored.
# Development needs no `.env`: plain `docker compose up --watch` uses
# compose.override.yaml instead.

# Makes every `docker compose` command on the server use the production files,
# so an accidental plain `docker compose up` can't start the development setup.
# On a Windows host, separate the files with `;` instead of `:`.
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# Public domain. Caddy gets the TLS certificate for it, and the site and API
# use https://<SITE_DOMAIN> as their origin. Point its DNS at the server first.
SITE_DOMAIN=shuuen.xyz

# Generate each with `openssl rand -hex 32`. Keep the Postgres password free of
# spaces and quotes, since it's embedded in the database DSN. Postgres only
# applies it when its data volume is first created.
POSTGRES_PASSWORD=
JWT_SECRET=

# Set both for one start to create the administrator, then clear them.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Public sign-up is disabled in production unless this is true.
REGISTRATION_ENABLED=false
