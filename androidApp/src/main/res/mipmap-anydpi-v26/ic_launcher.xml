<?xml version="1.0" encoding="utf-8"?>
<!--
  The glyph bitmaps are pure white with an alpha channel, so the same asset can serve
  both modes: the background colour and the foreground tint flip via values-night.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground>
        <bitmap
            android:src="@mipmap/ic_launcher_foreground"
            android:tint="@color/ic_launcher_foreground"/>
    </foreground>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
